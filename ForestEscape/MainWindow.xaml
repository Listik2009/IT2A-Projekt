<Window x:Class="ForestEscape.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Útěk z lesa"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Black">

    <Window.Resources>
        <Style x:Key="NeviditelnyCudlik" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">

                <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>

                <Canvas>

                    <Button x:Name="CarSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="291" Height="201"
                            Canvas.Left="356" Canvas.Top="434"
                            Click="CarSpot_Click" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.547,0.514">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleY="2.986"/>
                                <RotateTransform Angle="-1.706"/>
                                <TranslateTransform Y="8.062"/>
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>

                    <Button x:Name="BagSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="228" Height="200"
                            Canvas.Left="336" Canvas.Top="770"
                            Click="BagSpot_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <Button x:Name="FlashlightSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="220" Height="144"
                            Canvas.Left="850" Canvas.Top="798"
                            Click="FlashlightSpot_Click" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <Button x:Name="SignSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="241" Height="256"
                            Canvas.Left="1499" Canvas.Top="562"
                            Click="SignSpot_Click"/>

                    <Button x:Name="CaveSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="382" Height="362"
                            Canvas.Left="1300" Canvas.Top="168"
                            Click="CaveSpot_Click"/>

                    <Button x:Name="BoxSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="350" Height="350"
                            Canvas.Left="450" Canvas.Top="280"
                            Visibility="Hidden"
                            Click="BoxSpot_Click"/>

                    <Button x:Name="KeySpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="200" Height="200"
                            Canvas.Left="800" Canvas.Top="760"
                            Visibility="Hidden"
                            Click="KeySpot_Click"/>

                    <Button x:Name="LanternSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="260" Height="320"
                            Canvas.Left="1450" Canvas.Top="180"
                            Visibility="Hidden"
                            Click="LanternSpot_Click"/>

                    <Button x:Name="TunnelSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="500" Height="500"
                            Canvas.Left="1350" Canvas.Top="0"
                            Visibility="Hidden"
                            Click="TunnelSpot_Click"/>

                    <Button x:Name="BackForestSpot"
                            Width="220" Height="120"
                            Canvas.Left="20" Canvas.Top="20"
                            Content="ZPĚT"
                            Background="Black" Foreground="White"
                            Visibility="Hidden"
                            Click="BackForestSpot_Click"/>

                    <Button x:Name="CabinetSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="350" Height="420"
                            Canvas.Left="500" Canvas.Top="100"
                            Visibility="Hidden"
                            Click="CabinetSpot_Click"/>

                    <Button x:Name="AxeSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="300" Height="300"
                            Canvas.Left="300" Canvas.Top="580"
                            Visibility="Hidden"
                            Click="AxeSpot_Click"/>

                    <Button x:Name="FuelSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="450" Height="250"
                            Canvas.Left="800" Canvas.Top="600"
                            Visibility="Hidden"
                            Click="FuelSpot_Click"/>

                    <Button x:Name="GeneratorSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="500" Height="500"
                            Canvas.Left="1300" Canvas.Top="250"
                            Visibility="Hidden"
                            Click="GeneratorSpot_Click"/>

                    <Button x:Name="GateSpot"
                            Style="{StaticResource NeviditelnyCudlik}"
                            Width="700" Height="900"
                            Canvas.Left="1220" Canvas.Top="0"
                            Visibility="Hidden"
                            Click="GateSpot_Click"/>

                </Canvas>
            </Grid>
        </Viewbox>

        <Border Height="150"
                VerticalAlignment="Bottom"
                Background="#CC000000">
            <StackPanel Margin="15">
                <TextBlock Text="Inventory" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock x:Name="InventoryText" Foreground="White" FontSize="22" Margin="0,5,0,10"/>
                <TextBlock x:Name="GameText" Foreground="LightGreen" FontSize="28" Text="Probudil jsem se v lese..."/>
            </StackPanel>
        </Border>

        <Grid x:Name="IntroScreen"
      Panel.ZIndex="999">

            <Image Source="Images/intro.png"
           Stretch="UniformToFill"/>

            <Border Background="#55000000"/>

            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Button Content="Spustit hru"
                Width="320"
                Height="80"
                FontSize="28"
                Margin="0,350,0,20"
                Click="StartGame_Click"/>

                <Button Content="Ukončit"
                Width="320"
                Height="80"
                FontSize="28"
                Click="ExitGame_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>